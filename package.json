{
  "name": "btid-cli",
  "version": "0.1.0",
  "private": true,
  "description": "The BTID terminal front end: parse, one command from btid-core, print.",
  "bin": {
    "btid": "./dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "btid-core": "file:../btid-core",
    "githubdb": "file:../githubdb"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
