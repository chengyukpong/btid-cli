{
  "name": "btid-cli",
  "version": "0.3.0",
  "private": true,
  "description": "The BTID terminal front end: parse, one command from btid-core, print.",
  "bin": {
    "btid": "./dist/bin.js"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "npm run build"
  },
  "dependencies": {
    "btid-core": "file:../btid-core/release/btid-core-0.6.0.tgz",
    "githubdb": "file:../githubdb/release/githubdb-2.1.0.tgz"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  },
  "bundleDependencies": [
    "btid-core",
    "githubdb"
  ]
}
