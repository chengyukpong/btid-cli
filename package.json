{
    "name":  "btid-cli",
    "version":  "0.22.0",
    "private":  true,
    "description":  "The BTID terminal front end: parse, one command from btid-core, print.",
    "bin":  {
                "btid":  "./dist/bin.bundle.js"
            },
    "files":  [
                  "dist/bin.bundle.js"
              ],
    "scripts":  {
                    "build":  "tsc -p tsconfig.json \u0026\u0026 npm run bundle",
                    "bundle":  "esbuild src/bin.ts --bundle --minify --platform=node --target=node20 --format=cjs --outfile=dist/bin.bundle.js",
                    "typecheck":  "tsc --noEmit",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "prepack":  "npm run build",
                    "release":  "node scripts/release.mjs"
                },
    "devDependencies":  {
                            "@types/node":  "^22.10.2",
                            "@chengyukpong/btid-core":  "^0.33.0",
                            "esbuild":  "^0.28.2",
                            "@chengyukpong/githubdb":  "^2.2.1",
                            "typescript":  "^5.7.2",
                            "vitest":  "^3.0.5"
                        }
}